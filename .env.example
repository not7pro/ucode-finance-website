# ==============================================================================
# UCODE AGENCY OS — SUPABASE & NEXT.JS ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Public Keys (Client-side safe, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Private Admin Key (Server-side ONLY, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Demo Mode Switch (set to true to enable demo seed banners)
NEXT_PUBLIC_DEMO_MODE=true
